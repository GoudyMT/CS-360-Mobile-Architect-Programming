<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainInventoryActivity">

    <!-- Screen content. DrawerLayout applies the window insets to this child. -->
    <FrameLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/navy"
                app:subtitle="@string/inventory_subtitle"
                app:subtitleTextColor="@color/white_70"
                app:title="@string/inventory_title"
                app:titleTextColor="@color/white" />

            <!-- Filter header. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_margin"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm">

                <!-- Status tiles double as tappable quick-filters. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/tileAll"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tile"
                        android:backgroundTint="@color/navy"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_sm">

                        <TextView
                            android:id="@+id/tileAllCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="6" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/filter_all"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tileIn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tile"
                        android:backgroundTint="@color/stock_in_container"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_sm">

                        <TextView
                            android:id="@+id/tileInCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/stock_in"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="3" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/filter_in"
                            android:textColor="@color/stock_in"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tileLow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tile"
                        android:backgroundTint="@color/stock_low_container"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_sm">

                        <TextView
                            android:id="@+id/tileLowCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/stock_low_on"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/filter_low"
                            android:textColor="@color/stock_low_on"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tileOut"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tile"
                        android:backgroundTint="@color/stock_out_container"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_sm">

                        <TextView
                            android:id="@+id/tileOutCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/stock_out"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/filter_out"
                            android:textColor="@color/stock_out"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Search box: live DB-side filtering by name or SKU. -->
                <EditText
                    android:id="@+id/searchField"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_search"
                    android:drawablePadding="@dimen/space_sm"
                    android:drawableStart="@drawable/ic_search"
                    android:hint="@string/inventory_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/space_md"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_muted"
                    android:textSize="14sp" />

                <!-- Count + sort chooser. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/partsCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Parts (6)" />

                    <TextView
                        android:id="@+id/sortButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:drawablePadding="2dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingVertical="4dp"
                        android:textColor="@color/ink_muted"
                        android:textSize="12sp"
                        app:drawableEndCompat="@drawable/ic_arrow_drop_down"
                        tools:text="Sort: Name" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/partsList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="88dp"
                tools:itemCount="5"
                tools:listitem="@layout/item_part_card" />
        </LinearLayout>

        <!-- Receiving action; shown only to roles that can receive. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/scanFab"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/space_md"
            android:contentDescription="@string/fab_add_desc"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/amber"
            app:tint="@color/ink" />

        <!-- Pending marker over the hamburger; fades off as the drawer opens. -->
        <View
            android:id="@+id/hamburgerDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="32dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_badge_dot"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Navigation drawer: role-gated sections; identity header + Flightline styling. -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="288dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:itemBackground="@drawable/nav_item_bg"
        app:itemIconTint="@color/nav_item_tint"
        app:itemTextColor="@color/nav_item_text"
        app:menu="@menu/menu_nav"
        app:subheaderColor="@color/ink_muted" />
</androidx.drawerlayout.widget.DrawerLayout>
