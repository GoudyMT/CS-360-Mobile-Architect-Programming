<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ItemDetailActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/navy"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/item_detail_back_desc"
        app:navigationIconTint="@color/white"
        app:title="@string/item_detail_title"
        app:titleTextColor="@color/white" />

    <!-- Part data. Stays fixed while the bottom region morphs into the scan camera. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero: echoes the list card. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="76dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/heroAccent"
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    tools:background="@color/stock_low" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/screen_margin"
                    android:paddingVertical="@dimen/space_md">

                    <TextView
                        android:id="@+id/detailName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="Antenna Drive Motor" />

                    <TextView
                        android:id="@+id/detailSystemTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:background="@drawable/bg_system_tag"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/navy"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="DASR" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/screen_margin"
                    android:paddingVertical="@dimen/space_md">

                    <TextView
                        android:id="@+id/detailQuantity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        tools:text="3"
                        tools:textColor="@color/stock_low_on" />

                    <TextView
                        android:id="@+id/detailStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Low"
                        tools:textColor="@color/stock_low_on" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/detailContext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_md"
                android:textColor="@color/ink_muted"
                android:textSize="13sp"
                tools:text="Reorder at 4" />

            <!-- Detail rows. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_h"
                android:orientation="vertical"
                android:showDividers="beginning|middle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/screen_margin"
                    android:paddingVertical="@dimen/space_md">

                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_part_number"
                        android:textColor="@color/ink_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/detailPartNumber"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        tools:text="ADM-330" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/screen_margin"
                    android:paddingVertical="@dimen/space_md">

                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_location"
                        android:textColor="@color/ink_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/detailLocation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        tools:text="Bay B-06" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/screen_margin"
                    android:paddingVertical="@dimen/space_md">

                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_type"
                        android:textColor="@color/ink_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/detailType"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        tools:text="Consumable" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/screen_margin"
                    android:paddingVertical="@dimen/space_md">

                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_system"
                        android:textColor="@color/ink_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/detailSystem"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        tools:text="DASR - Digital Airport Surveillance Radar" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom region: shows the actions, or (on Check out) morphs into the scan camera. -->
    <FrameLayout
        android:id="@+id/bottomRegion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Actions. Delete appears only for roles that can remove parts. -->
        <LinearLayout
            android:id="@+id/actionStack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkOutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/detail_check_out"
                android:textSize="16sp"
                app:icon="@drawable/ic_camera"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/detail_report"
                app:icon="@drawable/ic_flag"
                app:iconGravity="textStart" />

            <!-- Delete + its note; revealed only for roles that can remove parts. -->
            <LinearLayout
                android:id="@+id/deleteGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deleteButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/detail_delete"
                    android:textColor="@color/stock_out"
                    app:icon="@drawable/ic_trash"
                    app:iconGravity="textStart"
                    app:iconTint="@color/stock_out"
                    app:strokeColor="@color/stock_out" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/detail_delete_role"
                    android:textColor="@color/ink_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Scan camera: live preview; the Confirm button commits the checkout. -->
        <LinearLayout
            android:id="@+id/cameraPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@color/navy">

                <com.journeyapps.barcodescanner.BarcodeView
                    android:id="@+id/checkoutCamera"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Aim guide over the preview. -->
                <View
                    android:layout_width="200dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_scan_frame" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:gravity="center"
                android:paddingHorizontal="@dimen/screen_margin"
                android:paddingTop="@dimen/space_md"
                android:text="@string/checkout_verify_hint"
                android:textColor="@color/ink_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:orientation="horizontal"
                android:padding="@dimen/screen_margin">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/confirm_cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/confirmButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/checkout_enter_number" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
