<?xml version="1.0" encoding="utf-8"?>
<!-- Selected drawer row: a navy_container pill, inset so it reads as a highlight not a full band. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset
            android:insetLeft="@dimen/space_sm"
            android:insetRight="@dimen/space_sm"
            android:insetTop="@dimen/space_xs"
            android:insetBottom="@dimen/space_xs">
            <shape android:shape="rectangle">
                <solid android:color="@color/navy_container" />
                <corners android:radius="@dimen/space_sm" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
